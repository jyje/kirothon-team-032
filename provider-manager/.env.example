# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Which provider `pm` uses: bedrock | openai | codex
PROVIDER=bedrock

# --- AWS Bedrock API key (bearer token) ---
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# --- OpenAI API key ---
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# --- OpenAI Codex subscription (sign in with the Codex CLI: codex login) ---
# CODEX_AUTH_FILE=~/.codex/auth.json
