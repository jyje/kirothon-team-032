# Copy to .env and fill in. .env is gitignored; never commit real keys.
# All values below are placeholders.

# Which provider `ask` uses: bedrock | openai | codex (default: openai)
PROVIDER=openai

# --- openai: OpenAI API key ---
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# --- bedrock: AWS Bedrock API key (bearer token) ---
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# --- codex (optional): ChatGPT subscription through the Codex CLI ---
# Off by default: nothing Codex-related is installed or required. PROVIDER=codex also turns it on.
# In the container, true makes the entrypoint install the Codex CLI if it is missing.
# CODEX_ENABLED=false
# Where the login is kept (container: mount a volume here so it survives restarts)
# CODEX_HOME=~/.codex
# Sign in once: codex login   (headless/container: codex login --device-auth)
# CODEX_AUTH_FILE=~/.codex/auth.json
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_TIMEOUT=120
