# Open Attendee 환경 변수 예시. 복사해서 webapp/.env 로 쓰고, 그 파일은 커밋하지 않는다.
#   cp webapp/.env.example webapp/.env

# ---- 비밀 (Kubernetes에서는 Secret으로 넣는다) ------------------------------
# 비밀번호 해시 만들기(출력만 보고 따로 저장한다):
#   cd webapp/src && uv run python -c "import getpass; from argon2 import PasswordHasher; print(PasswordHasher().hash(getpass.getpass()))"
# $ 가 들어 있으므로 작은따옴표로 감싼다.
OWNER_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# 쿠키 서명 키. 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
# AI 요약을 쓸 때만 (둘 중 하나)
# OPENAI_API_KEY=sk-...
# AWS_BEARER_TOKEN_BEDROCK=...

# ---- 일반 설정 (ConfigMap) --------------------------------------------------
PROVIDER=openai
DATA_DIR=./data
BLOB_BACKEND=local
# BLOB_BACKEND=s3인 경우 기존 버킷을 지정한다.
# S3_BUCKET=open-attendee-attachments
# S3_ENDPOINT_URL=https://object-storage.example.com
FEATURE_RECORDING=false
TRANSCRIBER=none
# NFS 같은 네트워크 볼륨에서는 delete. 로컬 디스크는 wal.
SQLITE_JOURNAL_MODE=wal
AWS_REGION=us-east-1
