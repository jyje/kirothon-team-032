{
  "version": "v1",
  "hooks": [
    {
      "name": "작업 완료 뒤 서버 테스트",
      "trigger": "PostTaskExec",
      "description": "스펙 작업 하나가 끝날 때마다 서버 테스트 전체를 실행해 회귀를 바로 잡는다.",
      "action": {
        "type": "command",
        "command": "cd webapp/src && uv run pytest -q",
        "timeout": 180
      }
    }
  ]
}